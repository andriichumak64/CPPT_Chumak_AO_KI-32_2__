<Window x:Class="lab2_23.Pages.CommentForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий коментар" Height="400" Width="900" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TitleText"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0 0 0 20"/>

        <!-- Поле для коментаря -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#CCC"
                CornerRadius="8"
                Padding="10">
            <TextBox x:Name="CommentText"
                     FontSize="16"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="150"/>
        </Border>

        <!-- Кнопка -->
        <Button Grid.Row="2"
                Content="Надіслати"
                Margin="0 20 0 0"
                HorizontalAlignment="Right"
                Width="150"
                Click="Send_Click"/>
    </Grid>
</Window>