<Window x:Class="lab2_23.Pages.CommentsList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Коментарі" Height="500" Width="800" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TitleText"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0 0 0 20"/>

        <!-- Немає коментарів -->
        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   Text="Коментарів поки немає"
                   FontSize="18"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Список коментарів -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="CommentsListBox">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1"
                                BorderBrush="#DDD"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0 0 0 15">

                            <StackPanel>
                                <TextBlock Text="{Binding Message}"
                                           FontSize="16"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding User.Login}"
                                           FontSize="14"
                                           Foreground="Gray"
                                           Margin="0 5 0 0"/>
                            </StackPanel>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>
