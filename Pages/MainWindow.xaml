<Window x:Class="lab4_23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маршрути" Height="600" Width="900">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0 0 0 20"
                    VerticalAlignment="Center">
            
            <StackPanel Width="250" Margin="0 0 20 0">
                <TextBlock Text="Маршрут" FontSize="14" Margin="0 0 0 5"/>
                <TextBox x:Name="SearchRouteBox"
                         FontSize="16"
                         Padding="8"
                         TextChanged="SearchChanged"/>
            </StackPanel>
            
            <StackPanel Width="250">
                <TextBlock Text="Транспорт" FontSize="14" Margin="0 0 0 5"/>
                <TextBox x:Name="SearchTransportBox"
                         FontSize="16"
                         Padding="8"
                         TextChanged="SearchChanged"/>
            </StackPanel>

        </StackPanel>
        
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="RoutesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1"
                                BorderBrush="#DDD"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0 0 0 15">

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"/>

                                    <TextBlock Text="{Binding TransportName}"
                                               FontSize="14"
                                               Foreground="Gray"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                        Content="Коментарі"
                                        Margin="10 0"
                                        Padding="10 5"
                                        Width="120"
                                        Tag="{Binding}"
                                        Click="OpenComments_Click"/>
                                
                                <Button Grid.Column="2"
                                        Content="Додати"
                                        Margin="10 0"
                                        Padding="10 5"
                                        Width="120"
                                        Tag="{Binding}"
                                        Click="AddComment_Click"/>
                            </Grid>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>
