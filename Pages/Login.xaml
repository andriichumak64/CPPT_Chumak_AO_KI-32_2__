<Window x:Class="lab2_23.Pages.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід" Height="450" Width="400" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Border Padding="20" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>

                <TextBlock Text="Авторизація"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0 0 0 20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Логін" FontSize="14" Margin="0 0 0 3"/>
                <TextBox x:Name="LoginBox"/>

                <TextBlock Text="Пароль" FontSize="14" Margin="0 0 0 3"/>
                <PasswordBox x:Name="PasswordBox"/>

                <Button Content="Увійти" Click="Login_Click"/>

                <Button Content="Немає акаунта? Зареєструватися"
                        Background="Transparent"
                        Foreground="#4A90E2"
                        BorderThickness="0"
                        Click="GoRegister_Click"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>