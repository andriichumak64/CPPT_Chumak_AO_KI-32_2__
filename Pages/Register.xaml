<Window x:Class="lab2_23.Pages.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="630" Width="400" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Border Padding="20" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>

                <TextBlock Text="Створення акаунта"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0 0 0 20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Логін" FontSize="14" Margin="0 0 0 3"/>
                <TextBox x:Name="LoginBox"/>

                <TextBlock Text="Email" FontSize="14" Margin="0 0 0 3"/>
                <TextBox x:Name="EmailBox"/>

                <TextBlock Text="Пароль" FontSize="14" Margin="0 0 0 3"/>
                <PasswordBox x:Name="PasswordBox"/>

                <TextBlock Text="Підтвердження паролю" FontSize="14" Margin="0 0 0 3"/>
                <PasswordBox x:Name="ConfirmPasswordBox"/>

                <Button Content="Зареєструватися" Click="Register_Click"/>

                <Button Content="Вже маєте акаунт? Увійти"
                        Background="Transparent"
                        Foreground="#4A90E2"
                        BorderThickness="0"
                        Click="GoLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>